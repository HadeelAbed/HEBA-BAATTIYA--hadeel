# ------------------------------------------------------------------
# HEBA BAATTIYA — environment template
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file (it is already git-ignored).
# ------------------------------------------------------------------

# Database (PostgreSQL on Neon — production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# In production set these on Vercel:
# AUTH_URL="https://your-domain.com"
AUTH_TRUST_HOST="true"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (for password reset / order confirmation emails)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@hebabaattiya.com"

# Payments — Tap Payments (MADA / VISA / MASTERCARD / APPLE_PAY / STC_PAY)
# ⚠️ SECRET — NEVER share these keys or commit them. Server-only.
# From your Tap dashboard (Developers -> Keys). Test: sk_test_...  Live: sk_live_...
TAP_SECRET_KEY=""
# From Tap dashboard (Developers -> Webhooks) — optional but strongly recommended
TAP_WEBHOOK_SECRET=""
TAP_BASE_URL="https://api.tap.company/v2"
# Webhook URL to register in Tap dashboard:
#   https://<your-domain>/api/payments/webhook

# Image storage (e.g. Cloudinary / S3) — for admin uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin access
# Accounts with these emails are treated as admins automatically (comma-separated).
ADMIN_EMAILS="admin@hebabaattiya.com"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="HEBA BAATTIYA"
