# ------------------------------------------------------------------
# Heba Baattiya — Environment Variables
# Copy this file to `.env` for local dev, and set the same keys on Vercel
# (Project Settings -> Environment Variables) for production.
# ------------------------------------------------------------------

# ----- Database -----
# Local dev (SQLite). For production use a Postgres connection string:
#   postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/dbname?sslmode=require
# Add the POOLED url as DATABASE_URL and the UNPOOLED one as DIRECT_URL on Vercel.
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# ----- Auth -----
# Generate with: openssl rand -base64 32   (or `npx auth secret`)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional OAuth — Google login
# 1) https://console.cloud.google.com -> Create project
# 2) APIs & Services -> OAuth consent screen -> configure (External)
# 3) Credentials -> Create OAuth client ID -> Web application
#    Authorized redirect URIs must include:
#      http://localhost:3000/api/auth/callback/google          (local)
#      https://YOUR-DOMAIN.com/api/auth/callback/google       (production)
# 4) Copy Client ID + Client Secret below
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----- Admin bootstrap (used by `prisma db seed`) -----
# In production, set a strong password. Fallback in seed is for dev only.
ADMIN_PASSWORD=""

# ----- Admin access -----
# Comma-separated emails that are treated as admins automatically on login.
# These people sign in with their OWN email + password and get /admin access.
# Example: ADMIN_EMAILS="owner@hebabaattiya.com,manager@hebabaattiya.com"
ADMIN_EMAILS=""

# ----- Email (password reset / order emails) -----
# Any SMTP works (Gmail app password, Outlook, Zoho, Brevo, Mailgun...).
# Gmail example: Host smtp.gmail.com, Port 587, User your@gmail.com,
# Password = 16-char "App password" from Google account security settings.
# If left empty, emails are logged to the server console (dev mode only).
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@hebabaattiya.com"

# ----- Payments (future) -----
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
MADA_MERCHANT_ID=""
MADA_API_KEY=""
STC_PAY_MERCHANT_ID=""
STC_PAY_API_KEY=""
APPLE_PAY_MERCHANT_ID=""
APPLE_PAY_CERT_PATH=""

# ----- Image storage (admin uploads, optional) -----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ----- App -----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="HEBA BAATTIYA"
